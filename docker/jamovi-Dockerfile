
FROM ubuntu:noble as base
FROM jamovi/jamovi-deps:2.7 as r-base


##### NODE #####

FROM base AS node-bin

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    xz-utils

RUN curl -L -f -o node.tar.xz https://nodejs.org/dist/v22.16.0/node-v22.16.0-linux-x64.tar.xz && \
    mkdir -p /node && \
    tar -xf node.tar.xz -C /node --strip-components=1


##### SERVER #####

FROM r-base AS server

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential \
    python3-dev \
    python3 \
    python3-pip \
    libprotobuf32t64 \
    protobuf-compiler \
    libboost-filesystem-dev \
    libboost-system-dev \
    libnanomsg-dev

ARG JAMOVI_ROOT=.
ARG MODS_ROOT=$JAMOVI_ROOT/docker/mods

COPY $JAMOVI_ROOT/docker/requirements.txt $MODS_ROOT/server/requirements.tx[t] /tmp/source/
RUN python3 -m pip install --trusted-host pypi.python.org -r /tmp/source/requirements.txt --break-system-packages

COPY $JAMOVI_ROOT/readstat /tmp/source/readstat
WORKDIR /tmp/source/readstat
RUN python3 setup.py install --install-lib=/usr/lib/jamovi/server --single-version-externally-managed --record=/dev/null

WORKDIR /tmp/source/server

COPY $JAMOVI_ROOT/server/setup.py           /tmp/source/server/
COPY $JAMOVI_ROOT/server/jamovi/core        /tmp/source/server/jamovi/core
COPY $JAMOVI_ROOT/server/jamovi/common      /tmp/source/server/jamovi/common
COPY $JAMOVI_ROOT/server/jamovi/core.pyx    /tmp/source/server/jamovi/
COPY $JAMOVI_ROOT/server/jamovi/__init__.py /tmp/source/server/jamovi/

RUN SETUP_CORE_ONLY=1 python3 setup.py install --install-lib=/usr/lib/jamovi/server --single-version-externally-managed --record=/dev/null

COPY $JAMOVI_ROOT/server/ $MODS_ROOT/server/ /tmp/source/server/
RUN SETUP_SERVER_ONLY=1 python3 setup.py install --install-lib=/usr/lib/jamovi/server --single-version-externally-managed --record=/dev/null

COPY $JAMOVI_ROOT/platform/env.conf /usr/lib/jamovi/bin/


####### CLIENT #######

FROM r-base AS client

COPY --from=node-bin /node /usr/local

ARG JAMOVI_ROOT=.
ARG MODS_ROOT=$JAMOVI_ROOT/docker/mods

COPY $JAMOVI_ROOT/client/package.json $MODS_ROOT/client/package.jso[n] /tmp/source/client/
WORKDIR /tmp/source/client

RUN npm install
RUN mkdir -p /usr/lib/jamovi/client

COPY $JAMOVI_ROOT/client/                           /tmp/source/client/
COPY   $MODS_ROOT/client/                           /tmp/source/client/
COPY $JAMOVI_ROOT/server/jamovi/server/jamovi.proto /tmp/source/client/assets/coms.proto

RUN node_modules/.bin/vite build --outDir /usr/lib/jamovi/client
# iMast: the 10 IVD menuGroups and the professional (non-alphabetical) subgroup/analysis order
# are implemented in client/main/instance.ts loadModules() + client/main/imast-menu-order.ts,
# so no post-build main-*.js string patch is needed anymore.
# iMast: subgroup flyout patch (referenced by index.html as /imast-flyout.js)
COPY $MODS_ROOT/client-patch/imast-flyout.js /usr/lib/jamovi/client/imast-flyout.js

COPY $JAMOVI_ROOT/version /usr/lib/jamovi/client


##### ENGINE #####

FROM r-base AS engine

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential \
    libprotobuf32t64 \
    protobuf-compiler \
    libboost-filesystem-dev \
    libboost-system-dev \
    libasio-dev \
    libprotobuf-dev \
    libnanomsg-dev

ARG JAMOVI_ROOT=.

COPY $JAMOVI_ROOT/engine                            /tmp/source/engine
COPY $JAMOVI_ROOT/server/jamovi/common              /tmp/source/server/jamovi/common
COPY $JAMOVI_ROOT/server/jamovi/server/jamovi.proto /tmp/source/server/jamovi/server/jamovi.proto

WORKDIR /tmp/source/engine

RUN bash configure --rhome=$R_HOME \
    --base-module-path=$R_HOME/library \
    --rpath=$R_HOME/library/RInside/lib \
    --rpath=$R_HOME/lib \
    CXXFLAGS=-DJAMOVI_ENGINE_SUPPORT_LOCAL_SOCKETS
RUN make
RUN DESTDIR=/usr/lib/jamovi make install


##### JMVCORE #####

FROM r-base AS jmvcore

ARG JAMOVI_ROOT=.

RUN mkdir -p /usr/lib/jamovi/modules/base/R

COPY $JAMOVI_ROOT/jmvcore /tmp/source/jmvcore
RUN R CMD INSTALL /tmp/source/jmvcore --library=/usr/lib/jamovi/modules/base/R

ENV R_LIBS /usr/lib/jamovi/modules/base/R

##### COMPILER #####

FROM jmvcore AS compiler

COPY --from=node-bin /node /usr/local

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    git

RUN mkdir -p /usr/lib/jamovi
RUN mkdir -p /usr/lib/jamovi/modules
RUN mkdir -p /usr/lib/jamovi/client
RUN mkdir -p /usr/lib/jamovi/bin

ARG JAMOVI_ROOT=.

COPY $JAMOVI_ROOT/version           /usr/lib/jamovi
COPY $JAMOVI_ROOT/platform/env.conf /usr/lib/jamovi/bin
COPY $JAMOVI_ROOT/platform/jamovi   /usr/lib/jamovi/bin
RUN chmod u+x /usr/lib/jamovi/bin/jamovi

COPY $JAMOVI_ROOT/jamovi-compiler /tmp/source/jamovi-compiler
WORKDIR /tmp/source/jamovi-compiler
RUN npm install && npm install -g

# IMASToolkits: additional R packages required by the 15 custom modules
ARG HTTP_PROXY=http://host.docker.internal:17890
ENV http_proxy=$HTTP_PROXY https_proxy=$HTTP_PROXY
RUN R -e "\
    packages <- c('e1071','nortest','tseries','moments','DescTools','lawstat', \
        'outliers','nortsTest','PMCMRplus','MethComp','goftest','mcr','deming'); \
    for (pkg in packages) { \
        install.packages(pkg, depends=TRUE, lib='$R_HOME/library', \
            INSTALL_opts='--no-data --no-help --no-demo --no-html --no-docs --no-multiarch --clean'); \
        library(pkg, character.only=TRUE); \
    }"
ENV http_proxy= https_proxy=


##### JMV #####

FROM compiler AS jmv

ARG JAMOVI_ROOT=.

COPY $JAMOVI_ROOT/jmv/ /tmp/source/jmv
WORKDIR /tmp/source/jmv
RUN jmc --install . --to /usr/lib/jamovi/modules --rhome $R_HOME --rlibs /usr/lib/jamovi/modules/base/R --patch-version --skip-deps
# IMAST: Copy IVD test datasets and updated jamovi.yaml with IVD dataset registrations
RUN mkdir -p /usr/lib/jamovi/modules/jmv/data/ivd
COPY $JAMOVI_ROOT/jmv/data/ivd/ /usr/lib/jamovi/modules/jmv/data/ivd/
COPY $JAMOVI_ROOT/jmv/jamovi.yaml /usr/lib/jamovi/modules/jmv/jamovi.yaml


##### EXTRAS #####

FROM compiler AS extras

ARG JAMOVI_ROOT=.

COPY $JAMOVI_ROOT/scatr/ /tmp/source/scatr
WORKDIR /tmp/source/scatr
RUN jmc --install . --to /usr/lib/jamovi/modules --rhome $R_HOME --rlibs /usr/lib/jamovi/modules/base/R

WORKDIR /tmp/source
RUN git clone https://github.com/davidfoxcroft/lsj-data.git /usr/lib/jamovi/modules/lsj-data
RUN git clone https://github.com/jamovi/r-datasets.git /usr/lib/jamovi/modules/r-datasets


##### IMAST CUSTOM MODULES #####

FROM compiler AS imast-mods

ARG JAMOVI_ROOT=.

COPY $JAMOVI_ROOT/docker/mods/imast/ /tmp/source/imast-mods/
WORKDIR /tmp/source/imast-mods

RUN for mod in ANOVA Appraisal ChiSquare CommutabilityAndStability Descriptive \
        DiscreteDistribution Estimation NonparametricTest Regression DynamicTable \
        IVD MinCrash Proficiency ReferenceMaterial YYT1709; do \
    echo "=== Building $mod ==="; \
    jmc --install $mod --to /usr/lib/jamovi/modules \
        --rhome $R_HOME --rlibs /usr/lib/jamovi/modules/base/R --skip-deps; \
done


##### I18N #####

FROM base AS i18n

COPY --from=node-bin /node /usr/local

RUN mkdir -p /usr/lib/jamovi/i18n/json

ARG JAMOVI_ROOT=.

COPY $JAMOVI_ROOT/i18n /tmp/source/i18n
WORKDIR /tmp/source/i18n
RUN npm install
RUN node /tmp/source/i18n/index.js --build src --dest /usr/lib/jamovi/i18n/json


##### FINAL #####

FROM r-base AS jamovi

ARG JAMOVI_ROOT=.

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    python3-minimal \
    python3-pip \
    python3-pkg-resources \
    python3-six \
    python3-protobuf \
    libnanomsg5 \
    libboost-filesystem1.83.0 \
    libprotobuf32t64 \
    protobuf-compiler \
    libicu74 \
    libgomp1 \
    libgfortran5 \
    libcurl4 \
    libpng16-16 \
    libjpeg9 \
    libcairo2 \
    libharfbuzz0b \
    libfribidi0 \
    libtiff6 \
    libreadline8

COPY --from=jmv     /usr/lib/jamovi/ /usr/lib/jamovi/
COPY --from=extras  /usr/lib/jamovi/ /usr/lib/jamovi/
COPY --from=imast-mods /usr/lib/jamovi/modules/ /usr/lib/jamovi/modules/
COPY --from=imast-mods /opt/R/4.5.0/lib/R/library/ /opt/R/4.5.0/lib/R/library/
COPY --from=client  /usr/lib/jamovi/client/ /usr/lib/jamovi/client/
COPY --from=i18n    /usr/lib/jamovi/i18n/json /usr/lib/jamovi/i18n/json
COPY --from=engine  /usr/lib/jamovi/bin/jamovi-engine /usr/lib/jamovi/bin/jamovi-engine
COPY --from=server  /usr/local/lib/python3.12/dist-packages /usr/local/lib/python3.12/dist-packages
COPY --from=server  /usr/lib/x86_64-linux-gnu/libnanomsg.so /usr/lib/x86_64-linux-gnu/libnanomsg.so
COPY --from=server  /usr/lib/jamovi/ /usr/lib/jamovi/

# ---- iMast LLM (AI assistant) service ----
RUN python3 -m pip install --no-cache-dir --break-system-packages \
    fastapi uvicorn requests websockets pydantic
COPY $JAMOVI_ROOT/llm /usr/lib/jamovi/llm/
COPY $JAMOVI_ROOT/docker/entrypoint-imast.sh /usr/local/bin/entrypoint-imast.sh
RUN chmod +x /usr/local/bin/entrypoint-imast.sh

# ---- iMast test data directory (for AI import_data tool) ----
RUN mkdir -p /data
COPY $JAMOVI_ROOT/jmv/data/ /data/

# ---- iMast PDF export: Chromium headless via playwright ----
# Replaces Electron's printToPDF(), which is unavailable in the Docker image.
RUN python3 -m pip install --no-cache-dir --break-system-packages playwright
RUN playwright install --with-deps chromium

ENV LD_LIBRARY_PATH $R_HOME/lib
ENV JAMOVI_HOME /usr/lib/jamovi
ENV PYTHONPATH /usr/lib/jamovi/server
ENV R_LIBS $R_HOME/library
ENV JAMOVI_SESSION_EXPIRES 0
ENV JAMOVI_ALLOW_ARBITRARY_CODE false
ENV JAMOVI_R_VERSION 4.5.0-x64

EXPOSE 41337 8000
ENTRYPOINT ["/bin/sh", "-c"]
CMD ["/usr/local/bin/entrypoint-imast.sh"]
